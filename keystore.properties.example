# Release signing template — copy to `keystore.properties` (repo root) and
# fill in your values. THAT file is gitignored; this template is the only one
# that gets committed. Never commit real passwords.
#
# 1) generate a keystore once (JDK's keytool, one line):
#      keytool -genkeypair -v -keystore andromeda-release.jks ^
#        -alias andromeda -keyalg RSA -keysize 2048 -validity 10000
#    (macOS/Linux: use the same command without the ^ line-continuation)
#
# 2) copy this file to keystore.properties next to it and fill in:
#
#    storeFile=andromeda-release.jks     (path relative to the repo root)
#    storePassword=your-keystore-password
#    keyAlias=andromeda
#    keyPassword=your-key-password
#
# 3) build a signed release:
#      build-apk.bat release      (Windows)
#      ./build-apk.sh release     (macOS/Linux)
#
# The keystore is the app's identity — lose it and you can never push an
# update to the same app id again (Play or otherwise). Back it up somewhere
# safe and offline.

storeFile=andromeda-release.jks
storePassword=
keyAlias=andromeda
keyPassword=
